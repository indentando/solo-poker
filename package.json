{
  "name": "solo-poker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @solo-poker/server\" \"npm run dev -w @solo-poker/web\"",
    "build": "npm run build -w @solo-poker/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
