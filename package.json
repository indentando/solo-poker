{
  "name": "solo-poker",
  "private": true,
  "description": "Póker Texas Hold'em con amigos, en el navegador y sin registros.",
  "license": "MIT",
  "author": "Alex Dorado",
  "homepage": "https://solo-poker.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/indentando/solo-poker.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm run dev -w @solo-poker/server\" \"npm run dev -w @solo-poker/web\"",
    "build": "npm run build -w @solo-poker/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
